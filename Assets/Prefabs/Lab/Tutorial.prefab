  firstLevelUI: {fileID: 511401958}
  secondLevelUITemplate: {fileID: 8634758756240002098}
  titleText: {fileID: 795979427}
  contentText: {fileID: 468440517}
  videoDisplay: {fileID: 8634758758281227233}
  tutorialDatas:
  - tutorialName: Tutorial_FirstLaunch
    nodes:
    - title: Collect The Sample
      content: Press the [] key to move.
      videoPlayer: {fileID: 0}
      renderTexture: {fileID: 8400000, guid: 3c6bcaaab71fec5438103e4d7a2b6b65, type: 2}
    - title: Collect The Sample
      content: Press the [] key to pick up the item.
      videoPlayer: {fileID: 0}
      renderTexture: {fileID: 8400000, guid: 3c6bcaaab71fec5438103e4d7a2b6b65, type: 2}
  - tutorialName: Tutorial_Microscope_OutSide
    nodes:
    - title: Confocal Microscopy(Exterior)
      content: Press [_] to turn on the light. No sample visibility in eyepiece otherwise.
      videoPlayer: {fileID: 0}
      renderTexture: {fileID: 8400000, guid: 3c6bcaaab71fec5438103e4d7a2b6b65, type: 2}
    - title: Confocal Microscopy(Exterior)
      content: Press [key name] to place sample on stage (same key for pick-up &
        placement).
      videoPlayer: {fileID: 0}
      renderTexture: {fileID: 8400000, guid: 3c6bcaaab71fec5438103e4d7a2b6b65, type: 2}
    - title: Confocal Microscopy(Exterior)
      content: Press [key name] to enter observation view.
      videoPlayer: {fileID: 0}
      renderTexture: {fileID: 8400000, guid: 3c6bcaaab71fec5438103e4d7a2b6b65, type: 2}
    - title: Confocal Microscopy(Exterior)
      content: Press [key name] again to enter microscope internal view.
      videoPlayer: {fileID: 0}
      renderTexture: {fileID: 8400000, guid: 3c6bcaaab71fec5438103e4d7a2b6b65, type: 2}
  - tutorialName: Tutorial_Microscope_InSide
    nodes:
    - title: Confocal Microscopy(Inside)
      content: Press [Key name] to control observation view movement.
      videoPlayer: {fileID: 0}
      renderTexture: {fileID: 8400000, guid: 3c6bcaaab71fec5438103e4d7a2b6b65, type: 2}
    - title: Confocal Microscopy(Inside)
      content: "Press [Key name] to adjust coarse/fine focus \u2192 Raise lens tube."
      videoPlayer: {fileID: 0}
      renderTexture: {fileID: 8400000, guid: 3c6bcaaab71fec5438103e4d7a2b6b65, type: 2}
    - title: Confocal Microscopy(Inside)
      content: "Press [Key name] to adjust coarse/fine focus \u2192 Lower lens tube."
      videoPlayer: {fileID: 0}
      renderTexture: {fileID: 8400000, guid: 3c6bcaaab71fec5438103e4d7a2b6b65, type: 2}
    - title: Confocal Microscopy(Inside)
      content: Press [Key name] to toggle coarse/fine adjustment knob.
      videoPlayer: {fileID: 0}
      renderTexture: {fileID: 8400000, guid: 3c6bcaaab71fec5438103e4d7a2b6b65, type: 2}
    - title: Confocal Microscopy(Inside)
      content: Press [Key name] to switch objective magnification.
      videoPlayer: {fileID: 0}
      renderTexture: {fileID: 8400000, guid: 3c6bcaaab71fec5438103e4d7a2b6b65, type: 2}
    - title: Confocal Microscopy(Inside)
      content: Press [Key name] to exit current observation.
      videoPlayer: {fileID: 0}
      renderTexture: {fileID: 8400000, guid: 3c6bcaaab71fec5438103e4d7a2b6b65, type: 2}
