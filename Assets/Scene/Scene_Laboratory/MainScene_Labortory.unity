MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1430339402}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 49d2628479ebcbb48aa622ef735ee465, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  tutorialTextDisplay: {fileID: 1589204588}
  uiRoot: {fileID: 229668829}
  alwaysFaceCamera: 1
  followDistance: 1.2
  followHeightOffset: -0.1
  faceCameraLerpSpeed: 5
  autoAdvanceDelay: 8
  bringTutorialToFront: 1
  frontSortingOrder: 500
  mandatoryConfiguredInputAcceptDelay: 2
  steps:
  - stepText: You have now entered observation mode.
    isMandatoryInteraction: 0
    acceptedButtons: 
    requireHoldButtonCombo: 0
    requiredHeldButton: 0
    inputAccessMode: 0
    onStepStart:
      m_PersistentCalls:
        m_Calls: []
    customUIAnchor: {fileID: 0}
  - stepText: We will now learn how to adjust the focal distance.
    isMandatoryInteraction: 0
    acceptedButtons: 
    requireHoldButtonCombo: 0
    requiredHeldButton: 0
    inputAccessMode: 0
    onStepStart:
      m_PersistentCalls:
        m_Calls: []
    customUIAnchor: {fileID: 0}
  - stepText: Press and hold the X button on the left controller while pushing the
      right controller thumbstick to the left, until an image appears on the screen.
    isMandatoryInteraction: 1
    acceptedButtons: 0f000000
    requireHoldButtonCombo: 1
    requiredHeldButton: 1
    inputAccessMode: 3
    onStepStart:
      m_PersistentCalls:
        m_Calls: []
    customUIAnchor: {fileID: 0}
  - stepText: Press and hold the X button on the left controller while pushing the
      right controller thumbstick to the right.
    isMandatoryInteraction: 1
    acceptedButtons: 10000000
    requireHoldButtonCombo: 1
    requiredHeldButton: 1
    inputAccessMode: 3
    onStepStart:
      m_PersistentCalls:
        m_Calls: []
    customUIAnchor: {fileID: 0}
  - stepText: Push the left controller thumbstick upward to move the image upward.
    isMandatoryInteraction: 1
    acceptedButtons: 09000000
    requireHoldButtonCombo: 0
    requiredHeldButton: 0
    inputAccessMode: 1
    onStepStart:
      m_PersistentCalls:
        m_Calls: []
    customUIAnchor: {fileID: 0}
  - stepText: Likewise, you can use this thumbstick to move the image in any direction.
    isMandatoryInteraction: 0
    acceptedButtons: 
    requireHoldButtonCombo: 0
    requiredHeldButton: 0
    inputAccessMode: 0
    onStepStart:
      m_PersistentCalls:
        m_Calls: []
    customUIAnchor: {fileID: 0}
  - stepText: Well done. You have completed the focal distance adjustment tutorial.
    isMandatoryInteraction: 0
    acceptedButtons: 
    requireHoldButtonCombo: 0
    requiredHeldButton: 0
    inputAccessMode: 0
    onStepStart:
      m_PersistentCalls:
        m_Calls: []
    customUIAnchor: {fileID: 0}
  - stepText: Press and hold the X button on the left controller while pushing the
      right controller thumbstick upward.
    isMandatoryInteraction: 1
    acceptedButtons: 0d000000
    requireHoldButtonCombo: 1
    requiredHeldButton: 1
    inputAccessMode: 3
    onStepStart:
      m_PersistentCalls:
        m_Calls: []
    customUIAnchor: {fileID: 0}
  - stepText: Press and hold the X button on the left controller while pushing the
      right controller thumbstick downward.
    isMandatoryInteraction: 1
    acceptedButtons: 0e000000
    requireHoldButtonCombo: 1
    requiredHeldButton: 1
    inputAccessMode: 3
    onStepStart:
      m_PersistentCalls:
        m_Calls: []
    customUIAnchor: {fileID: 0}
  - stepText: Well done. You have completed the light source adjustment tutorial.
    isMandatoryInteraction: 0
    acceptedButtons: 
    requireHoldButtonCombo: 0
    requiredHeldButton: 0
    inputAccessMode: 0
    onStepStart:
      m_PersistentCalls:
        m_Calls: []
    customUIAnchor: {fileID: 0}
  - stepText: You can press the right controller thumbstick inward to switch between
      coarse and fine focus adjustment. Please try this after the tutorial is complete.
    isMandatoryInteraction: 0
    acceptedButtons: 
    requireHoldButtonCombo: 0
    requiredHeldButton: 0
    inputAccessMode: 0
    onStepStart:
      m_PersistentCalls:
        m_Calls: []
    customUIAnchor: {fileID: 0}
  - stepText: Well done. You have learned how to switch between coarse and fine focus
      adjustment for focal distance control.
    isMandatoryInteraction: 0
    acceptedButtons: 
    requireHoldButtonCombo: 0
    requiredHeldButton: 0
    inputAccessMode: 0
    onStepStart:
      m_PersistentCalls:
        m_Calls: []
    customUIAnchor: {fileID: 0}
  - stepText: Press the A button on the right controller to switch between objective
      lenses.
    isMandatoryInteraction: 1
    acceptedButtons: 05000000
    requireHoldButtonCombo: 0
    requiredHeldButton: 0
    inputAccessMode: 1
    onStepStart:
      m_PersistentCalls:
        m_Calls: []
    customUIAnchor: {fileID: 0}
  - stepText: Well done. You have learned how to switch objective lenses to achieve
      different magnifications.
    isMandatoryInteraction: 0
    acceptedButtons: 
    requireHoldButtonCombo: 0
    requiredHeldButton: 0
    inputAccessMode: 0
    onStepStart:
      m_PersistentCalls:
        m_Calls: []
    customUIAnchor: {fileID: 0}
  - stepText: When operating the microscope, an appropriate focal distance, light
      intensity, and objective lens are all required to obtain a clearer image.
    isMandatoryInteraction: 0
    acceptedButtons: 
    requireHoldButtonCombo: 0
    requiredHeldButton: 0
    inputAccessMode: 0
    onStepStart:
      m_PersistentCalls:
        m_Calls: []
    customUIAnchor: {fileID: 0}
  - stepText: Please make sure you understand the microscope operation workflow.
      After this tutorial, you can press Y to open the tutorial menu and review it
      again.
    isMandatoryInteraction: 0
    acceptedButtons: 
    requireHoldButtonCombo: 0
    requiredHeldButton: 0
    inputAccessMode: 0
    onStepStart:
      m_PersistentCalls:
        m_Calls: []
    customUIAnchor: {fileID: 0}
  - stepText: Press the trigger on the left controller to exit observation mode.
    isMandatoryInteraction: 1
    acceptedButtons: 03000000
    requireHoldButtonCombo: 0
    requiredHeldButton: 0
    inputAccessMode: 2
    onStepStart:
      m_PersistentCalls:
        m_Calls: []
    customUIAnchor: {fileID: 0}
  onTutorialStart:
    m_PersistentCalls:
      m_Calls: []
  onTutorialFinish:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 97735849}
